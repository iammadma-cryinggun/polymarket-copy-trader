# Polymarket Copy Trader - 环境配置

# ==================== Polygon 节点 ====================
# Alchemy Polygon WebSocket URL
# 🔧 获取方式: https://dashboard.alchemy.com/apps -> 创建 Polygon Mainnet 应用 -> 复制 WebSocket URL
# ⚠️ 429 限流提示: Alchemy 免费版限制并发 WS 连接数，若多个实例同时运行会触发 429。
#    程序会自动切换备用 RPC（下方 POLYGON_WS_FALLBACK），或在配额重置/释放连接后恢复。
POLYGON_WS_URL=wss://polygon-mainnet.g.alchemy.com/v2/YOUR_API_KEY

# 备用 WebSocket URL（逗号分隔，可选；主 RPC 限流/不可用时自动轮换）
# 不设置则默认使用公共端点:
#   wss://polygon-bor-rpc.publicnode.com
#   wss://polygon.api.onfinality.io/public
#   wss://polygon.drpc.org
# POLYGON_WS_FALLBACK=wss://polygon-bor-rpc.publicnode.com,wss://polygon.api.onfinality.io/public,wss://polygon.drpc.org

# ==================== Polymarket API ====================
# Polymarket CLOB API（无需修改）
CLOB_API_URL=https://clob.polymarket.com

# ==================== 跟单目标 ====================
# 目标钱包地址（要跟单的地址）
# 示例: 0xf418d3a1a941292f9c8707d62a14980c5beb95a3
TARGET_WALLET=0xf418d3a1a941292f9c8707d62a14980c5beb95a3

# ==================== 交易配置 ====================
# 私钥（用于签名交易，不要提交到 Git！）
# 🔧 获取方式: MetaMask 导出私钥
# ⚠️ 警告: 泄露私钥 = 失去所有资金
PRIVATE_KEY=your_private_key_here

# 跟单金额（USDC）
# 建议: 小额起步（$10-$50），验证策略后再加仓
COPY_TRADE_AMOUNT=10

# 最大滑点（比例）
# 如果大户以 0.60 入场，当前盘口 0.75，滑点 = 25%
# 建议: 0.10-0.20（10%-20%），超过此比例放弃跟单
MAX_SLIPPAGE=0.15

# 最小剩余时间（秒）
# 5分钟市场的最后30秒流动性差、滑点大，建议跳过
MIN_REMAINING_TIME=30

# ==================== 熔断保护 ====================
# 1 分钟内最多跟单次数（防目标钱包刷单/做市瞬间跟单过多）
# 建议: 2-5
MAX_ORDERS_PER_MINUTE=2

# 当日累计投入上限（USDC），超过后当日停止跟单（保护资金）
# 建议: 50-100，视风险承受力而定
DAILY_SPEND_CAP=50

# ==================== 数据库 ====================
# SQLite 数据库路径（自动创建）
DB_PATH=copy_trades.db

# ==================== 自动赎回 ====================
# 是否启用自动赎回（中奖后自动调用 CTF Exchange V2 redeemPositions 兑换成 pUSD）
# 可选: true / false
REDEEM_ENABLED=false

# 赎回扫描间隔（秒）
REDEEM_SCAN_INTERVAL=300

# 最小赎回金额（当前价值低于该值跳过，节省 Gas）
REDEEM_MIN_AMOUNT=0.10

# Polygon HTTP RPC URL（赎回交易使用，可选）
# 不设置则使用 https://polygon-rpc.com
POLYGON_RPC_URL=

# ==================== 进程 ====================
# 单例锁文件路径（可选）。程序会自动加锁防止多个实例同时运行，
# 避免共用一个 RPC Key 触发 429 限流。一般不修改。
# SINGLE_INSTANCE_LOCK=.copy-trader.lock

# ==================== 日志 ====================
# 日志级别: error, warn, info, debug, trace
RUST_LOG=info
