# Polymarket Copy Trader - 环境配置

# ==================== Polygon 节点 ====================
# Alchemy Polygon WebSocket URL
# 🔧 获取方式: https://dashboard.alchemy.com/apps -> 创建 Polygon Mainnet 应用 -> 复制 WebSocket URL
POLYGON_WS_URL=wss://polygon-mainnet.g.alchemy.com/v2/YOUR_API_KEY

# ==================== Polymarket API ====================
# Polymarket CLOB API（无需修改）
CLOB_API_URL=https://clob.polymarket.com

# ==================== 跟单目标 ====================
# 目标钱包地址（要跟单的地址）
# 示例: 0xf418d3a1a941292f9c8707d62a14980c5beb95a3
TARGET_WALLET=0xf418d3a1a941292f9c8707d62a14980c5beb95a3

# ==================== 交易配置 ====================
# 私钥（用于签名交易，不要提交到 Git！）
# 🔧 获取方式: MetaMask 导出私钥
# ⚠️ 警告: 泄露私钥 = 失去所有资金
PRIVATE_KEY=your_private_key_here

# 跟单金额（USDC）
# 建议: 小额起步（$10-$50），验证策略后再加仓
COPY_TRADE_AMOUNT=10

# 最大滑点（比例）
# 如果大户以 0.60 入场，当前盘口 0.75，滑点 = 25%
# 建议: 0.10-0.20（10%-20%），超过此比例放弃跟单
MAX_SLIPPAGE=0.15

# 最小剩余时间（秒）
# 5分钟市场的最后30秒流动性差、滑点大，建议跳过
MIN_REMAINING_TIME=30

# ==================== 数据库 ====================
# SQLite 数据库路径（自动创建）
DB_PATH=copy_trades.db

# ==================== 日志 ====================
# 日志级别: error, warn, info, debug, trace
RUST_LOG=info
