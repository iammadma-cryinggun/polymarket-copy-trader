# Polymarket Copy Trader - 环境配置

# ==================== Polygon 节点 ====================
# Alchemy Polygon WebSocket URL
POLYGON_WS_URL=wss://polygon-mainnet.g.alchemy.com/v2/YOUR_API_KEY

# ==================== Polymarket API ====================
# Polymarket CLOB API
CLOB_API_URL=https://clob.polymarket.com

# ==================== 跟单目标 ====================
# 目标钱包地址（要跟单的地址）
TARGET_WALLET=0xf418d3a1a941292f9c8707d62a14980c5beb95a3

# ==================== 交易配置 ====================
# 私钥（用于签名交易，不要提交到 Git！）
PRIVATE_KEY=your_private_key_here

# 跟单金额（USDC）
COPY_TRADE_AMOUNT=20

# 最大滑点（如果价格变化超过此比例，放弃跟单）
MAX_SLIPPAGE=0.15

# 最小剩余时间（秒）- 最后30秒不跟单
MIN_REMAINING_TIME=30

# ==================== 数据库 ====================
# SQLite 数据库路径
DB_PATH=copy_trades.db

# ==================== 日志 ====================
RUST_LOG=info
